# Ночной бэкап lukinterlab.ru: база Postgres + media + .env.docker → /srv/backups
# Установка (на сервере, из /srv/lukinterlab.ru):
#   cp deploy/backup/lukinterlab-backup.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now lukinterlab-backup.timer
# Ручной запуск: systemctl start lukinterlab-backup.service
# Итог: cat /srv/backups/LAST_STATUS ; подробно: /srv/backups/backup.log
[Unit]
Description=LukInterLab: бэкап базы и media в /srv/backups
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/bin/bash /srv/lukinterlab.ru/deploy/backup/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
