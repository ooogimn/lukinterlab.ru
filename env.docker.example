# Пример для Docker / VPS: скопируйте в .env.docker (рядом с docker-compose.yml)
# и подставьте секреты. Файл .env.docker в git не коммитить.
#
# Локально только postgres+redis (Django в .venv на хосте):
#   POSTGRES_HOST=127.0.0.1
#   REDIS_URL=redis://127.0.0.1:6379/1
#   DJANGO_Q_REDIS_HOST=127.0.0.1
#
# Сервис web в compose (имена хостов из сети Docker):
#   POSTGRES_HOST=postgres
#   REDIS_URL=redis://redis:6379/1
#   DJANGO_Q_REDIS_HOST=redis

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Для захода по IP VPS добавьте его в список (через запятую), иначе DisallowedHost.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,lukinterlab.ru,www.lukinterlab.ru
SITE_URL=https://lukinterlab.ru
# DATA_UPLOAD_MAX_MB=512

# --- PostgreSQL ---
POSTGRES_DB=lukinterlab
POSTGRES_USER=lukinterlab
POSTGRES_PASSWORD=замените_на_случайную_строку
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_CONN_MAX_AGE=60

# --- Redis: кэш Django и брокер Django-Q (обязательно) ---
# Только writable/master (не внешняя read-replica). В compose — сервис redis.
REDIS_URL=redis://redis:6379/1
# REDIS_CACHE_IGNORE_ERRORS=True — при падении Redis сайт отдаёт страницы без кэша (см. settings.py).
# Отдельный префикс/БД для «filesystem»-кэша (та же Redis, другой KEY_PREFIX)
# REDIS_URL_FILECACHE=redis://redis:6379/1
REDIS_CACHE_KEY_PREFIX=luk
# REDIS_PASSWORD=
DJANGO_Q_REDIS_HOST=redis
DJANGO_Q_REDIS_PORT=6379
DJANGO_Q_REDIS_DB=0

# Django-Q
DJANGO_Q_SYNC=False
# DJANGO_Q_WORKERS=2
# DJANGO_Q_TASK_TIMEOUT=3600

# --- GigaChat (нужны web и qcluster; без них автопост Assistant падает) ---
# Формат: KEY=значение, без пробелов вокруг =, без Python-кавычек.
# Обязательно держите копию в ЭТОМ файле (.env.docker): docker-compose не читает корневой .env для web/qcluster.
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_VERIFY_SSL=False
USE_GIGACHAT_PARSING=True
GIGACHAT_PARSING_FALLBACK=True

# Остальные ключи — как в env.example (VK, MAX, почта и т.д.)
