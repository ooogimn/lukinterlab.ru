# Скопируйте в файл .env в корне проекта и заполните (файл .env в git не коммитится).
# Секретный ключ Django:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=
# Локально можно True; на сервере — False
DJANGO_DEBUG=True

# --- PostgreSQL и Redis (обязательно). Без POSTGRES_* и REDIS_URL Django не стартует.
POSTGRES_DB=lukinterlab
POSTGRES_USER=lukinterlab
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_CONN_MAX_AGE=60
REDIS_URL=redis://127.0.0.1:6379/1
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
DJANGO_Q_REDIS_HOST=127.0.0.1
DJANGO_Q_REDIS_PORT=6379
DJANGO_Q_REDIS_DB=0
# DJANGO_Q_WORKERS=2
# Docker: см. env.docker.example
# Django-Q: True = async_task в том же процессе (отладка). На сервере держите False и запускайте qcluster.
# DJANGO_Q_SYNC=False
# Макс. время одной задачи (сек): генерация + паузы batch_interval между статьями. По умолчанию в settings 3600.
# DJANGO_Q_TASK_TIMEOUT=3600
# Повтор после сбоя (сек), не меньше timeout; по умолчанию max(600, 2 * DJANGO_Q_TASK_TIMEOUT).
# DJANGO_Q_RETRY=7200

SITE_URL=https://lukinterlab.ru
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,lukinterlab.ru,www.lukinterlab.ru
# Через запятую, если нужны нестандартные origins; иначе строятся из SITE_URL
# DJANGO_CSRF_TRUSTED_ORIGINS=https://lukinterlab.ru,https://www.lukinterlab.ru

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-1002200401634
# Анонсы статей в канал; False — не ставить задачи в очередь (дашборд «Мониторинг» может дополнительно выключить)
# TELEGRAM_CHANNEL_AUTOPOST=True

# --- VK: постинг в группу ---
# Ключ СООБЩЕСТВА (стена) — wall.post
VK_ACCESS_TOKEN=
# Пользовательский токен админа группы (OAuth: scope=offline,photos — см. кабинет приложения VK). Без него фото не прикрепится (API 27).
VK_USER_ACCESS_TOKEN=
VK_GROUP_ID=231035215
VK_AUTO_POST=True

# --- MAX (мессенджер): анонсы в чат/канал ---
# MAX_BOT_TOKEN=
# MAX_CHAT_ID=
# MAX_AUTO_POST=False
# Сколько слов в теле анонса VK и MAX (заголовок и «Читать далее» не режутся). 0 = только лимит символов API.
# SOCIAL_ANNOUNCE_MAX_WORDS=100
# Размер кадра превью для VK и MAX (JPEG после центр-обрезки). По умолчанию 1200×630 (~формат OG).
# SOCIAL_SHARE_IMAGE_WIDTH=1200
# SOCIAL_SHARE_IMAGE_HEIGHT=630
# Добавлять в конец текста VK/MAX ссылку «Читать далее: URL». False — только заголовок и тизер (удобно для чистого видео-поста).
# SOCIAL_INCLUDE_ARTICLE_LINK=True

# Callback API: публичный URL https://SITE/callback/СЛУЖЕБНЫЙ_СЕГМЕНТ/ (тот же сегмент, что в настройках сервера VK)
VK_CALLBACK_PATH_SLUG=
# Строка подтверждения из кабинета сообщества (ответ сервера на type=confirmation)
VK_CALLBACK_CONFIRMATION=
# Секретный ключ сервера Callback API (проверка поля secret в уведомлениях)
VK_CALLBACK_SECRET=

# --- VK ID (личный кабинет) ---
VKID_APP_ID=54515641
VKID_REDIRECT_URL=https://lukinterlab.ru/
VKID_PROTECTED_KEY=
VKID_SERVICE_KEY=

# --- GigaChat ---
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_VERIFY_SSL=False
USE_GIGACHAT_PARSING=True
GIGACHAT_PARSING_FALLBACK=True
USE_CLOUDSCRAPER=True
USE_TRAFILATURA=True
USE_ASYNC_PARSING=False
# Сколько слов тянуть из статьи-источника в промпт (по умолчанию 480; было ~250)
# ARTICLE_PARSED_NEWS_TARGET_WORDS=480

# --- Почта SMTP ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LukInterLab <noreply@lukinterlab.ru>

CONTACT_EMAIL=Ya@LukyanovSY.ru
ADMIN_EMAIL=Ya@LukyanovSY.ru

# --- ЮKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- OpenAI (если используете) ---
OPENAI_API_KEY=

# Устаревший алиас (если где-то задано SECRET_KEY — тоже подхватится)
# SECRET_KEY=
