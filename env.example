# Скопируйте в файл .env в корне проекта и заполните (файл .env в git не коммитится).
# Секретный ключ Django:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=
# Локально можно True; на сервере — False
DJANGO_DEBUG=True

SITE_URL=https://lukinterlab.ru
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,lukinterlab.ru,www.lukinterlab.ru
# Через запятую, если нужны нестандартные origins; иначе строятся из SITE_URL
# DJANGO_CSRF_TRUSTED_ORIGINS=https://lukinterlab.ru,https://www.lukinterlab.ru

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-1002200401634

# --- VK: постинг в группу ---
VK_ACCESS_TOKEN=
VK_GROUP_ID=231035215
VK_AUTO_POST=True

# --- VK ID (личный кабинет) ---
VKID_APP_ID=54515641
VKID_REDIRECT_URL=https://lukinterlab.ru/
VKID_PROTECTED_KEY=
VKID_SERVICE_KEY=

# --- GigaChat ---
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_VERIFY_SSL=False
USE_GIGACHAT_PARSING=True
GIGACHAT_PARSING_FALLBACK=True
USE_CLOUDSCRAPER=True
USE_TRAFILATURA=True
USE_ASYNC_PARSING=False

# --- Почта SMTP ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LukInterLab <noreply@lukinterlab.ru>

CONTACT_EMAIL=Ya@LukyanovSY.ru
ADMIN_EMAIL=Ya@LukyanovSY.ru

# --- ЮKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- OpenAI (если используете) ---
OPENAI_API_KEY=

# Устаревший алиас (если где-то задано SECRET_KEY — тоже подхватится)
